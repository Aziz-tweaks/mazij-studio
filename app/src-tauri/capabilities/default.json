{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "opener:default",
    "dialog:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/Mazij"
        },
        {
          "path": "$HOME/Mazij/**"
        },
        {
          "path": "$APPDATA"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$DOCUMENT/Exports"
        },
        {
          "path": "$DOCUMENT/Exports/**"
        }
      ]
    },
    "fs:allow-mkdir",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-remove",
    "fs:allow-read-dir",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/ffmpeg",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/livephoto",
          "sidecar": true,
          "args": true
        }
      ]
    },
    "shell:allow-kill",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/ffmpeg",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/livephoto",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
